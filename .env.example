# Copiar a .env y completar DB_HOST con la IP real de la VM Debian.
# El mismo archivo sirve para Docker y LXC, sin modificar app.py.
DB_HOST=REEMPLAZAR_POR_IP_VM
DB_PORT=5432
DB_NAME=musicos_bandas
DB_USER=app_musicos
DB_PASSWORD=SO2Proxmox2026!
# En Docker: puerto local de Apache hacia esta app (default 5000).
APP_PORT=5000
# Solo si hay que salir a Internet por un proxy durante docker build.
# Es PROXY DE SALIDA, NO para comunicarse con PostgreSQL.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,192.168.0.0/16
